# Same contract as api-corevent. Prefer DB_URL when set.
DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# Synthetic fallback size (used when Postgres is empty or unreachable)
SYNTHETIC_N_USERS=3000
SYNTHETIC_N_EVENTS=200
SYNTHETIC_SEED=42

# Pipeline defaults
OUTPUT_DIR=outputs
MIN_SUPPORT=0.05
MIN_CONFIDENCE=0.3
KMEANS_K_MAX=8
TEST_SIZE=0.25
RANDOM_STATE=42
